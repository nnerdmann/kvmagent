NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=replace-with-token
NETBOX_TENANT=default
NETBOX_SITE=default
NETBOX_CLUSTER_TYPE=KVM
NETBOX_API_RETRIES=3
NETBOX_RETRY_BACKOFF=1.5
NETBOX_SSL_VERIFY=true
NETBOX_CA_CERTS_FILE=/etc/ssl/certs/ca-certificates.crt

# Empty means local libvirt socket.
KVM_ADDR=
CHECK_INTERVAL=300
RUN_ONCE=true
LOG_LEVEL=INFO
